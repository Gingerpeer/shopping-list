# Server configuration
PORT=3000

# Secret used to sign JSON Web Tokens. MUST be set to a long random value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Lifetime of an authenticated session token.
JWT_EXPIRES_IN=7d

# Location of the SQLite database file.
DB_PATH=./data/shopping.db

# Bootstrap admin account. The very first account is auto-approved and granted the
# admin role when its phone number matches ADMIN_PHONE. Use E.164 format, e.g. +14155550100
ADMIN_PHONE=

# Set to "production" to enable secure cookies (HTTPS only).
NODE_ENV=development
