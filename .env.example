# Server configuration
PORT=3000

# Secret used to sign JSON Web Tokens. MUST be set to a long random value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Lifetime of an authenticated session token.
JWT_EXPIRES_IN=7d

# PostgreSQL connection string. On Railway, add a PostgreSQL plugin and
# reference its DATABASE_URL variable (e.g. ${{ Postgres.DATABASE_URL }}).
# Locally this defaults to a Postgres listening on localhost:5432.
DATABASE_URL=******localhost:5432/shopping

# Set to "true" to require TLS for the database connection (needed for some
# managed/public Postgres endpoints). Railway's internal networking does not
# need this. It is also enabled automatically when the URL has sslmode=require.
DATABASE_SSL=false

# Bootstrap admin account. The very first account is auto-approved and granted the
# admin role when its phone number matches ADMIN_PHONE. Use E.164 format, e.g. +14155550100
ADMIN_PHONE=

# Set to "production" to enable secure cookies (HTTPS only).
NODE_ENV=development
